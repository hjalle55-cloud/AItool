/* =============================================
   TRAVEL BUDDY AI - styles.css
   ============================================= */

:root {
  --sand: #F5EDD9;
  --sand-light: #FDFAF3;
  --ocean: #2C6E8A;
  --ocean-dark: #1B4F72;
  --sky: #7BB8D4;
  --sky-light: #D6EDF7;
  --gold: #E8B86D;
  --gold-light: #FDF3DC;
  --coral: #E8735A;
  --coral-light: #FDEAE5;
  --white: #FFFFFF;
  --text-dark: #1A2B3C;
  --text-mid: #4A5F72;
  --text-light: #8FA3B3;
  --radius-sm: 8px;
  --radius-md: 16px;
  --radius-lg: 28px;
  --shadow-soft: 0 4px 24px rgba(44, 110, 138, 0.10);
  --shadow-card: 0 8px 40px rgba(44, 110, 138, 0.13);
  --font-display: 'Cormorant Garamond', Georgia, serif;
  --font-body: 'DM Sans', system-ui, sans-serif;
  --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  font-family: var(--font-body);
  background: var(--sand-light);
  color: var(--text-dark);
  line-height: 1.6;
  overflow-x: hidden;
}

/* NAVBAR */
.navbar {
  position: fixed;
  top: 0; left: 0;
  width: 100%;
  z-index: 100;
  padding: 18px 0;
  background: rgba(253, 250, 243, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(232, 184, 109, 0.18);
}

.nav-inner {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
}

.logo-icon {
  width: 38px; height: 38px;
  background: linear-gradient(135deg, var(--ocean), var(--sky));
  color: white;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: 0.5px;
}

.logo-text {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 600;
  color: var(--text-dark);
}

.logo-text em { font-style: italic; color: var(--ocean); }

.nav-links {
  display: flex;
  list-style: none;
  gap: 32px;
  align-items: center;
}

.nav-links a {
  text-decoration: none;
  color: var(--text-mid);
  font-size: 14px;
  font-weight: 500;
  transition: color var(--transition);
}

.nav-links a:hover { color: var(--ocean); }

.nav-cta {
  background: var(--ocean) !important;
  color: white !important;
  padding: 10px 22px;
  border-radius: 50px;
  font-weight: 600 !important;
  transition: background var(--transition), transform var(--transition) !important;
}

.nav-cta:hover {
  background: var(--ocean-dark) !important;
  transform: translateY(-1px);
}

/* BACKGROUND SHAPES */
.hero-bg-shapes {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -1;
  overflow: hidden;
}

.shape {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.35;
}

.shape-1 {
  width: 600px; height: 600px;
  background: radial-gradient(circle, var(--sky-light), transparent 70%);
  top: -100px; right: -100px;
  animation: float1 12s ease-in-out infinite;
}

.shape-2 {
  width: 400px; height: 400px;
  background: radial-gradient(circle, var(--gold-light), transparent 70%);
  bottom: 100px; left: -80px;
  animation: float2 16s ease-in-out infinite;
}

.shape-3 {
  width: 300px; height: 300px;
  background: radial-gradient(circle, var(--coral-light), transparent 70%);
  top: 50%; left: 40%;
  animation: float1 20s ease-in-out infinite reverse;
}

@keyframes float1 {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(30px, -40px); }
}

@keyframes float2 {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(-20px, 30px); }
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(30px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* HERO */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 120px 32px 80px;
  max-width: 1180px;
  margin: 0 auto;
  gap: 60px;
}

.hero-content {
  flex: 1;
  max-width: 580px;
  animation: fadeUp 0.8s ease both;
}

.hero-badge {
  display: inline-block;
  background: var(--gold-light);
  color: var(--ocean-dark);
  border: 1px solid var(--gold);
  border-radius: 50px;
  padding: 6px 18px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  margin-bottom: 24px;
}

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(44px, 6vw, 72px);
  font-weight: 700;
  line-height: 1.1;
  color: var(--text-dark);
  margin-bottom: 22px;
  letter-spacing: -0.5px;
}

.accent-text { color: var(--ocean); font-style: italic; }

.hero-sub {
  font-size: 17px;
  color: var(--text-mid);
  line-height: 1.7;
  margin-bottom: 36px;
  max-width: 460px;
}

.hero-actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 48px;
}

.btn-primary {
  background: var(--ocean);
  color: white;
  padding: 14px 32px;
  border-radius: 50px;
  text-decoration: none;
  font-weight: 600;
  font-size: 15px;
  transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
  box-shadow: 0 4px 16px rgba(44, 110, 138, 0.3);
}

.btn-primary:hover {
  background: var(--ocean-dark);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(44, 110, 138, 0.4);
}

.btn-secondary {
  border: 2px solid var(--ocean);
  color: var(--ocean);
  padding: 13px 28px;
  border-radius: 50px;
  text-decoration: none;
  font-weight: 600;
  font-size: 15px;
  transition: all var(--transition);
}

.btn-secondary:hover { background: var(--sky-light); }

.hero-stats {
  display: flex;
  align-items: center;
  gap: 24px;
}

.stat { display: flex; flex-direction: column; }

.stat-num {
  font-family: var(--font-display);
  font-size: 30px;
  font-weight: 700;
  color: var(--ocean);
  line-height: 1;
}

.stat-label {
  font-size: 12px;
  color: var(--text-light);
  font-weight: 500;
  margin-top: 2px;
}

.stat-divider {
  width: 1px; height: 36px;
  background: rgba(44, 110, 138, 0.2);
}

/* HERO VISUAL */
.hero-visual {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeUp 0.8s 0.2s ease both;
}

.chat-card {
  background: white;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  width: 340px;
  overflow: hidden;
  border: 1px solid rgba(232, 184, 109, 0.2);
}

.chat-header {
  background: linear-gradient(135deg, var(--ocean-dark), var(--ocean));
  padding: 18px 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  color: white;
}

.chat-avatar {
  width: 40px; height: 40px;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 700;
}

.chat-name { font-weight: 600; font-size: 14px; }
.chat-status { font-size: 11px; opacity: 0.75; margin-top: 2px; }

.chat-status::before {
  content: '';
  display: inline-block;
  width: 6px; height: 6px;
  background: #4cd964;
  border-radius: 50%;
  margin-right: 5px;
  vertical-align: middle;
}

.chat-body {
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: var(--sand-light);
}

.chat-bubble {
  max-width: 85%;
  padding: 11px 15px;
  border-radius: 16px;
  font-size: 13.5px;
  line-height: 1.5;
}

.chat-bubble.ai {
  background: white;
  color: var(--text-dark);
  border-radius: 4px 16px 16px 16px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  align-self: flex-start;
}

.chat-bubble.user {
  background: var(--ocean);
  color: white;
  border-radius: 16px 4px 16px 16px;
  align-self: flex-end;
  text-align: right;
}

.chat-typing {
  display: flex;
  gap: 5px;
  padding: 11px 15px;
  background: white;
  border-radius: 4px 16px 16px 16px;
  width: fit-content;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.chat-typing span {
  width: 7px; height: 7px;
  background: var(--sky);
  border-radius: 50%;
  animation: typing 1.2s ease-in-out infinite;
}

.chat-typing span:nth-child(2) { animation-delay: 0.2s; }
.chat-typing span:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing {
  0%, 100% { transform: translateY(0); opacity: 0.5; }
  50% { transform: translateY(-5px); opacity: 1; }
}

.floating-tag {
  position: absolute;
  background: white;
  border-radius: 50px;
  padding: 8px 16px;
  font-size: 12px;
  font-weight: 600;
  box-shadow: var(--shadow-soft);
  white-space: nowrap;
  border: 1px solid rgba(232, 184, 109, 0.25);
  animation: float2 6s ease-in-out infinite;
}

.tag-1 { top: 20px; right: -20px; color: var(--ocean-dark); animation-delay: 0s; }
.tag-2 { bottom: 120px; left: -30px; color: var(--coral); animation-delay: 2s; }
.tag-3 { bottom: 40px; right: -10px; color: var(--ocean); animation-delay: 4s; }

/* SHARED SECTION */
.section-inner {
  max-width: 1180px;
  margin: 0 auto;
  padding: 100px 32px;
}

.section-label {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--ocean);
  background: var(--sky-light);
  padding: 6px 16px;
  border-radius: 50px;
  margin-bottom: 20px;
}

.section-label.light {
  color: white;
  background: rgba(255,255,255,0.15);
}

.section-title {
  font-family: var(--font-display);
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 700;
  color: var(--text-dark);
  line-height: 1.15;
  margin-bottom: 16px;
}

.section-sub {
  font-size: 16px;
  color: var(--text-mid);
  max-width: 620px;
  line-height: 1.7;
  margin-bottom: 64px;
}

/* HOW IT WORKS */
.how-it-works { background: var(--white); }

.steps-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-bottom: 60px;
}

.step-card {
  background: var(--sand-light);
  border: 1px solid rgba(232, 184, 109, 0.2);
  border-radius: var(--radius-md);
  padding: 36px 28px;
  transition: transform var(--transition), box-shadow var(--transition);
}

.step-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-card);
}

.step-card.featured {
  background: linear-gradient(145deg, var(--ocean-dark), var(--ocean));
  color: white;
  border-color: transparent;
}

.step-card.featured h3,
.step-card.featured p { color: white; }

.step-num {
  font-family: var(--font-display);
  font-size: 48px;
  font-weight: 700;
  color: var(--sand);
  line-height: 1;
  margin-bottom: 12px;
}

.step-card.featured .step-num { color: rgba(255,255,255,0.15); }

.step-icon-wrap { width: 48px; height: 48px; margin-bottom: 20px; }
.step-icon-wrap svg { width: 100%; height: 100%; }

.step-card h3 {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 12px;
}

.step-card p { font-size: 14px; color: var(--text-mid); line-height: 1.7; }

.pipeline {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  background: var(--sand-light);
  border: 1px solid rgba(232, 184, 109, 0.25);
  border-radius: var(--radius-md);
  padding: 28px 32px;
}

.pipe-node {
  background: white;
  border: 1.5px solid rgba(44, 110, 138, 0.2);
  color: var(--ocean-dark);
  border-radius: 50px;
  padding: 10px 20px;
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
}

.pipe-node.highlight {
  background: var(--ocean);
  color: white;
  border-color: transparent;
  font-weight: 600;
}

.pipe-arrow { color: var(--gold); font-weight: 700; font-size: 18px; padding: 0 4px; }

/* FEATURES */
.features { background: var(--sand-light); }

.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.feature-card {
  background: white;
  border: 1px solid rgba(232, 184, 109, 0.2);
  border-radius: var(--radius-md);
  padding: 30px 24px;
  transition: transform var(--transition), box-shadow var(--transition);
}

.feature-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-card);
}

.feature-card.large {
  grid-column: span 2;
  background: linear-gradient(135deg, var(--sky-light), white);
}

.feature-icon { width: 48px; height: 48px; margin-bottom: 18px; }
.feature-icon svg { width: 100%; height: 100%; }

.feature-card h3 {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 10px;
}

.feature-card p { font-size: 14px; color: var(--text-mid); line-height: 1.7; }

.feature-tag {
  display: inline-block;
  background: var(--gold-light);
  color: var(--ocean-dark);
  border: 1px solid var(--gold);
  border-radius: 50px;
  padding: 4px 14px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  margin-top: 16px;
}

/* HOW TO USE */
.how-to-use { background: white; }

.use-steps {
  max-width: 700px;
  display: flex;
  flex-direction: column;
}

.use-step { display: flex; gap: 28px; padding-bottom: 8px; }

.use-step-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.use-step-num {
  width: 48px; height: 48px;
  background: var(--ocean);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 700;
}

.use-step-line {
  flex: 1;
  width: 2px;
  background: linear-gradient(to bottom, var(--sky), transparent);
  margin: 8px 0;
  min-height: 60px;
}

.use-step-content { padding: 8px 0 48px; }

.use-step-content h3 {
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 10px;
}

.use-step-content p { font-size: 15px; color: var(--text-mid); line-height: 1.7; margin-bottom: 16px; }

.use-tip {
  background: var(--gold-light);
  border-left: 3px solid var(--gold);
  padding: 12px 16px;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-size: 13px;
  color: var(--ocean-dark);
}

.code-example {
  background: var(--text-dark);
  color: #a8d8ea;
  padding: 14px 18px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  font-style: italic;
  line-height: 1.6;
}

.code-prompt { color: var(--gold); font-style: normal; font-weight: 700; margin-right: 8px; }

/* TESTIMONIALS */
.testimonials { background: var(--sand-light); }

.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 48px;
}

.testimonial-card {
  background: white;
  border-radius: var(--radius-md);
  padding: 28px;
  border: 1px solid rgba(232, 184, 109, 0.2);
  transition: transform var(--transition);
}

.testimonial-card:hover { transform: translateY(-4px); }

.testimonial-card.featured-testimonial {
  background: linear-gradient(145deg, var(--ocean-dark), var(--ocean));
  border-color: transparent;
}

.testimonial-card.featured-testimonial p,
.testimonial-card.featured-testimonial .author-name,
.testimonial-card.featured-testimonial .author-trip { color: white !important; }

.testimonial-stars { color: var(--gold); font-size: 14px; letter-spacing: 4px; margin-bottom: 14px; }
.testimonial-card.featured-testimonial .testimonial-stars { color: var(--gold-light); }

.testimonial-card p { font-size: 15px; color: var(--text-mid); line-height: 1.7; margin-bottom: 22px; font-style: italic; }

.testimonial-author { display: flex; align-items: center; gap: 12px; }

.author-avatar {
  width: 42px; height: 42px;
  background: linear-gradient(135deg, var(--sky), var(--ocean));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 12px;
  font-weight: 700;
}

.testimonial-card.featured-testimonial .author-avatar { background: rgba(255,255,255,0.2); }

.author-name { font-size: 14px; font-weight: 600; color: var(--text-dark); }
.author-trip { font-size: 12px; color: var(--text-light); margin-top: 2px; }

/* CTA */
.cta-section {
  background: linear-gradient(145deg, var(--ocean-dark) 0%, var(--ocean) 60%, #2E86AB 100%);
  position: relative;
  overflow: hidden;
}

.cta-shapes { position: absolute; inset: 0; pointer-events: none; }

.cta-shape-1 {
  position: absolute;
  width: 500px; height: 500px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232,184,109,0.15), transparent 70%);
  top: -200px; right: -100px;
}

.cta-shape-2 {
  position: absolute;
  width: 400px; height: 400px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.07), transparent 70%);
  bottom: -150px; left: 100px;
}

.cta-inner {
  max-width: 700px;
  margin: 0 auto;
  padding: 100px 32px;
  text-align: center;
  position: relative;
}

.cta-title {
  font-family: var(--font-display);
  font-size: clamp(36px, 5vw, 60px);
  font-weight: 700;
  color: white;
  margin-bottom: 16px;
  line-height: 1.15;
}

.cta-sub { font-size: 16px; color: rgba(255,255,255,0.78); margin-bottom: 40px; line-height: 1.7; }

.cta-input-row {
  display: flex;
  max-width: 560px;
  margin: 0 auto 16px;
  background: white;
  border-radius: 50px;
  padding: 6px;
  box-shadow: 0 8px 40px rgba(0,0,0,0.2);
}

.cta-input {
  flex: 1;
  border: none;
  outline: none;
  font-family: var(--font-body);
  font-size: 15px;
  color: var(--text-dark);
  padding: 12px 20px;
  background: transparent;
  border-radius: 50px;
}

.cta-input::placeholder { color: var(--text-light); }

.cta-btn {
  background: var(--ocean-dark);
  color: white;
  border: none;
  border-radius: 50px;
  padding: 12px 28px;
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: background var(--transition), transform var(--transition);
}

.cta-btn:hover { background: var(--text-dark); transform: scale(1.03); }

.cta-note { font-size: 13px; color: rgba(255,255,255,0.55); }

/* FOOTER */
.footer { background: var(--text-dark); padding: 40px 32px; }

.footer-inner {
  max-width: 1180px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
}

.footer .logo-text { color: white; }

.footer-links { display: flex; gap: 28px; flex-wrap: wrap; }

.footer-links a {
  text-decoration: none;
  color: rgba(255,255,255,0.5);
  font-size: 13px;
  transition: color var(--transition);
}

.footer-links a:hover { color: var(--gold); }

.footer-copy { color: rgba(255,255,255,0.3); font-size: 12px; width: 100%; text-align: center; margin-top: 8px; }

/* RESPONSIVE */
@media (max-width: 900px) {
  .hero { flex-direction: column; padding-top: 100px; text-align: center; }
  .hero-sub, .hero-actions { margin-left: auto; margin-right: auto; justify-content: center; }
  .hero-stats { justify-content: center; }
  .hero-visual { width: 100%; }
  .tag-1, .tag-2, .tag-3 { display: none; }
  .steps-grid { grid-template-columns: 1fr; }
  .features-grid { grid-template-columns: 1fr; }
  .feature-card.large { grid-column: span 1; }
  .testimonials-grid { grid-template-columns: 1fr; }
  .cta-input-row { flex-direction: column; border-radius: var(--radius-md); padding: 12px; gap: 10px; }
  .cta-btn { width: 100%; text-align: center; }
  .pipeline { display: none; }
  .footer-inner { flex-direction: column; text-align: center; }
  .footer-links { justify-content: center; }
}
